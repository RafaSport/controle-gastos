generator client {
  provider   = "prisma-client-js"
  engineType = "client"
  output     = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Papel {
  ADMIN
  COMPRADOR
}

enum Cartao {
  NUBANK
  INTER
  HIPER
  ITAU
}

model Usuario {
  id            String   @id @default(uuid())
  nome          String
  sobrenome     String
  login         String   @unique
  senha         String
  papel         Papel    @default(COMPRADOR)
  primeiroLogin Boolean  @default(true)
  usaUber       Boolean  @default(false)
  criadoEm      DateTime @default(now())

  compras       Compra[]
  mesesFechados MesFechado[]
  corridas      Corrida[]
}

model Compra {
  id           String   @id @default(uuid())
  usuarioId    String
  cartao       Cartao
  descricao    String
  mesCompra    Int
  anoCompra    Int
  mesInicio    Int
  anoInicio    Int
  qtdParcelas  Int
  mesFinal     Int
  anoFinal     Int
  valorParcela Float
  criadoEm     DateTime @default(now())

  usuario      Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}

model MesFechado {
  id             String   @id @default(uuid())
  usuarioId      String
  mes            Int
  ano            Int
  totalDoMes     Float    @default(0)
  totalPago      Float    @default(0)
  dividaAnterior Float    @default(0)

  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, mes, ano])
}

model Corrida {
  id            String   @id @default(uuid())
  usuarioId     String
  data          DateTime
  mesReferencia Int
  anoReferencia Int
  valor         Float
  criadoEm      DateTime @default(now())

  usuario       Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
}